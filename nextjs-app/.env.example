# Aqla v2 staging is AWS-first.
# No credentials or secrets belong in this file.
# Runtime AWS access is granted through the Amplify SSR Compute role.
# Sensitive values are stored in AWS Secrets Manager.

# Core staging resources
AQLA_DYNAMODB_TABLE=aqla-v2-staging
AQLA_APP_URL=https://staging.smokefreeksa.com
AQLA_SES_FROM=Aqla <noreply@smokefreeksa.com>
AQLA_SES_REPLY_TO=smokefreeksa@gmail.com
AQLA_SES_CONFIGURATION_SET=aqla-transactional

# Automated Day 3 / Day 7 / Day 30 follow-up resources.
# The staging application has safe defaults for these exact resource names;
# set these explicitly when promoting to another environment/account.
AQLA_AWS_ACCOUNT_ID=150252718453
AQLA_FOLLOWUP_SCHEDULER_GROUP=aqla-v2-staging-followups
AQLA_FOLLOWUP_LAMBDA_ARN=arn:aws:lambda:eu-west-2:150252718453:function:aqla-v2-staging-followup-worker
AQLA_FOLLOWUP_SCHEDULER_ROLE_ARN=arn:aws:iam::150252718453:role/aqla-v2-staging-followup-scheduler-invoke
AQLA_FOLLOWUP_DLQ_ARN=arn:aws:sqs:eu-west-2:150252718453:aqla-v2-staging-followup-dlq
