# Aqla staging is AWS-first.
# No credentials or secret values belong in this file.
# Runtime AWS access is granted through the Amplify SSR Compute role.
# Sensitive values are stored in AWS Secrets Manager.

# Core staging resources
AWS_REGION=eu-west-2
AQLA_DYNAMODB_TABLE=aqla-v2-staging
AQLA_APP_URL=https://staging.smokefreeksa.com

# Public analytics baseline used only when the aggregate visit counter has not yet been created.
AQLA_PUBLIC_VISIT_SEED=1852

# Cognito configuration (the client secret value itself remains in Secrets Manager)
AQLA_COGNITO_REGION=eu-west-2
AQLA_COGNITO_USER_POOL_ID=eu-west-2_xYZywGOuy
AQLA_COGNITO_CLIENT_ID=7m1po5aph23iv3d9btms8n3udb
AQLA_COGNITO_ISSUER=https://cognito-idp.eu-west-2.amazonaws.com/eu-west-2_xYZywGOuy
AQLA_COGNITO_DOMAIN=https://eu-west-2xyzywgouy.auth.eu-west-2.amazoncognito.com
AQLA_COGNITO_CLIENT_SECRET_ID=aqla/v2/staging/cognito-client

# AI wording personalisation. Secret value stays in Secrets Manager.
AQLA_OPENAI_SECRET_ID=aqla/v2/staging/openai
AQLA_OPENAI_MODEL=gpt-5.6
AQLA_OPENAI_TIMEOUT_MS=10000
# Limits only anonymous OpenAI wording personalisation. Deterministic guest plans remain available after the limit.
AQLA_GUEST_AI_HOURLY_LIMIT=6

# Transactional email
AQLA_SES_FROM=Aqla <noreply@smokefreeksa.com>
AQLA_SES_REPLY_TO=smokefreeksa@gmail.com
AQLA_SES_CONFIGURATION_SET=aqla-transactional

# Longitudinal follow-up resources for Day 1, 3, 7, 14, 21, 30, 60, 90, month 6 and month 12.
# The staging application has safe defaults for these exact resource names;
# set these explicitly when promoting to another environment/account.
AQLA_AWS_ACCOUNT_ID=150252718453
AQLA_FOLLOWUP_SCHEDULER_GROUP=aqla-v2-staging-followups
AQLA_FOLLOWUP_LAMBDA_ARN=arn:aws:lambda:eu-west-2:150252718453:function:aqla-v2-staging-followup-worker
AQLA_FOLLOWUP_SCHEDULER_ROLE_ARN=arn:aws:iam::150252718453:role/aqla-v2-staging-followup-scheduler-invoke
AQLA_FOLLOWUP_DLQ_ARN=arn:aws:sqs:eu-west-2:150252718453:aqla-v2-staging-followup-dlq

# Research export is deny-by-default. Enable only after the applicable protocol/data-use scope is confirmed.
AQLA_RESEARCH_EXPORT_ENABLED=false
